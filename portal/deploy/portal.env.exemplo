# /etc/rede-aberta/portal.env — chmod 640 root:rede. NUNCA commitar o arquivo real.
REDE_AMBIENTE=producao
REDE_NOME="Telefone Fixo"
REDE_SECRET_KEY=TROCAR_64_HEX
REDE_DATABASE_URL=postgresql+psycopg2://portal:TROCAR@localhost/telefone
REDE_SITE_URL=https://rede.exemplo.org.br
REDE_PROV_URL=https://rede.exemplo.org.br
REDE_SIP_HOST=IP_PUBLICO_DO_VPS
# Cifragem das linhas novas: nenhuma | transicao | exigida (TLS na 5061 + SRTP). Em producao: exigida, depois de
# rodar deploy/tls.sh (que grava esta linha quando chamado com FECHAR_TCP=1). O site afirma que a ligacao e cifrada.
REDE_SIP_CIFRAGEM=exigida
# Conferencia do certificado da central pelo aparelho (bancada B27): nome que esta no certificado da porta TLS e
# quais linhas conferem (todas, ou IDs separados por virgula num piloto). Sem as duas, o aparelho nao confere.
#REDE_SIP_CERT_NOME=rede.exemplo.org.br
#REDE_SIP_CERT_LINHAS=todas
# Copia do banco fora do servidor (deploy/copia-externa.sh grava esta linha): o job diario avisa se atrasar
#REDE_COPIA_EXTERNA_STATUS=/var/backups/rede-aberta/copia-externa.ok
REDE_SMTP_USER=conta@gmail.com
REDE_SMTP_PASSWORD=app_password
# Remetente com o dominio pelo Gmail comum: no Gmail, "Enviar e-mail como" contato@telefonefixo.org
# apontando para smtp.gmail.com com senha de app; no DNS, SPF com include:_spf.google.com (feito em 07/11/2026).
REDE_MAIL_FROM=contato@telefonefixo.org
# GDMS (caminho 3). Modo: desligado | simulado | real
REDE_GDMS_MODO=real
REDE_GDMS_BASE_URL=https://www.gdms.cloud
REDE_GDMS_CLIENT_ID=
REDE_GDMS_CLIENT_SECRET=
REDE_GDMS_USERNAME=
REDE_GDMS_PASSWORD=
REDE_GDMS_ORG_ID=
REDE_GDMS_SITE_ID=
# api (device/config/xml, sem operador) | manual (tarefa no painel)
REDE_GDMS_ENVIO_MODO=api
# ponteiro (so P237 + travas; conta SIP vem do nosso servidor) | completo
REDE_GDMS_XML_CONTEUDO=ponteiro
# segredo longo e aleatorio; faz parte da URL do webhook registrada no GDMS (flask gdms-eventos)
REDE_GDMS_WEBHOOK_SEGREDO=
# Tronco da operadora (B23): numero fixo da rede, so digitos com DDD, sem 55. Vazio = sem tronco.
REDE_TRONCO_NUMERO=
# Numero que aparece no celular quando a crianca liga (B30, tronco Vono). Vazio = o mesmo de cima.
REDE_TRONCO_NUMERO_SAIDA=
# Canais contratados na Vono (B30); 0 = sem Vono. Teto de minutos por canal por mes e fracao usada antes de desviar para a Nvoip.
REDE_VONO_CANAIS=0
REDE_VONO_MIN_CANAL_MES=5000
REDE_VONO_FRACAO=0.8

# Chamada em grupo (doc 16): voz sintetica e ARI do Asterisk (servico rede-grupo)
REDE_VOZ_BACKEND=auto
REDE_VOZ_DIR=/var/lib/rede-aberta/sons
REDE_VOZ_PIPER_MODELO=/opt/rede-aberta/piper/pt_BR-faber-medium.onnx
REDE_ARI_URL=http://127.0.0.1:8088/ari
REDE_ARI_USUARIO=rede
REDE_ARI_SENHA=TROCAR
REDE_GRUPO_MAX_NA_CHAMADA=4

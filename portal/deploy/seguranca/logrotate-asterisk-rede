# Telefone Fixo: rotacao dos logs do Asterisk. O logrotate do pacote Debian casa com
# /var/log/asterisk/messages (sem .log), entao messages.log e security.log nunca giravam.
# Em 25/10/2026 os scanners de SIP geraram 4,6 milhoes de linhas num dia (1,2 GB).
/var/log/asterisk/messages.log /var/log/asterisk/security.log {
        daily
        maxsize 50M
        rotate 7
        compress
        delaycompress
        missingok
        notifempty
        sharedscripts
        postrotate
                /usr/sbin/asterisk -rx 'logger reload' > /dev/null 2>&1 || true
        endscript
}

; pjsip_tronco.conf — tronco da operadora (Nvoip). Gerado por deploy/tronco.sh a partir de
; ~/.config/rede-aberta/bancada.env; o arquivo real fica so no servidor (/etc/asterisk, 640 asterisk).
; Molde: provisionador oficial da Nvoip (github.com/Nvoip/nvoip-pabx-provisioner, lib/render.sh).
[nvoip-reg]
type=registration
outbound_auth=nvoip-auth
server_uri=sip:__SERVIDOR__
client_uri=sip:__USUARIO__@__SERVIDOR__
contact_user=__USUARIO__
retry_interval=60
forbidden_retry_interval=600
max_retries=10000
expiration=300
line=yes
endpoint=nvoip
transport=transport-udp

[nvoip-auth]
type=auth
auth_type=userpass
username=__USUARIO__
password=__SENHA__

[nvoip]
type=aor
contact=sip:__SERVIDOR__:5060
qualify_frequency=60

[nvoip]
type=endpoint
context=tronco-entrada
disallow=all
allow=ulaw,alaw
outbound_auth=nvoip-auth
aors=nvoip
from_user=__USUARIO__
from_domain=__SERVIDOR__
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
transport=transport-udp
dtmf_mode=rfc4733
language=pt_BR

[nvoip]
type=identify
endpoint=nvoip
match=__SERVIDOR__

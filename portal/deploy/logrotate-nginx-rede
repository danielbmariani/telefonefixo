# /etc/logrotate.d/nginx-rede — registros de acesso do site por 6 meses (Marco Civil, art. 15, por prudencia)
/var/log/nginx/access.log /var/log/nginx/rede-prov.log {
    weekly
    rotate 26
    missingok
    compress
    delaycompress
    notifempty
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 `cat /var/run/nginx.pid`
    endscript
}

[Unit]
Description=Rede Aberta - Portal
After=network.target postgresql.service

[Service]
Type=simple
User=rede
Group=rede
WorkingDirectory=/opt/rede-aberta/portal
EnvironmentFile=/etc/rede-aberta/portal.env
Environment=FLASK_APP=wsgi:app
ExecStart=/opt/rede-aberta/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
